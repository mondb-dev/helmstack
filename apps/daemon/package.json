{
  "name": "@helmstack/daemon",
  "version": "0.1.0",
  "private": true,
  "description": "Headless HelmStack runtime that drives a plain Chrome over CDP",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
